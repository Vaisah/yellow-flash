Unicode true

####
## Yellow Flash's installer, built by `wails build -nsis` (wails_tools.nsh is
## regenerated by every build; this file is ours and kept).
##
## It installs for the current user, without an administrator prompt, into
## %LOCALAPPDATA%\Programs\Yellow Flash, everything the app needs:
##   Yellow Flash.exe      the app
##   yellowflash-nmhost    the browser helper (the extension talks to it)
##   yellowflash-cli       the command line
##   yellowflash-mcp       the MCP server for AI assistants
##   browser-extension\    the extension, for browsers that load it from a folder
## and registers the browser helper with every browser, so the extension
## finds Yellow Flash as soon as it is added. On first start the app offers
## to add the extension to each installed browser.
##
## Build the helpers into build\bin before `wails build -nsis` (without
## -clean, which empties build\bin): see .github/workflows/release.yml.
####

!define INFO_COMPANYNAME   "Yellow Flash"
!define PRODUCT_EXECUTABLE "Yellow Flash.exe"
!define UNINST_KEY_NAME    "Yellow Flash"
!define REQUEST_EXECUTION_LEVEL "user"
!define WAILS_INSTALL_SCOPE "user"

!define SHORTCUT_NAME  "Yellow Flash"
!define BROWSER_HELPER "yellowflash-nmhost.exe"
!define RUN_KEY        "Software\Microsoft\Windows\CurrentVersion\Run"

!include "wails_tools.nsh"

# The version information for this two must consist of 4 parts
VIProductVersion "${INFO_PRODUCTVERSION}.0"
VIFileVersion    "${INFO_PRODUCTVERSION}.0"

VIAddVersionKey "CompanyName"     "${INFO_COMPANYNAME}"
VIAddVersionKey "FileDescription" "${INFO_PRODUCTNAME} Installer"
VIAddVersionKey "ProductVersion"  "${INFO_PRODUCTVERSION}"
VIAddVersionKey "FileVersion"     "${INFO_PRODUCTVERSION}"
VIAddVersionKey "LegalCopyright"  "${INFO_COPYRIGHT}"
VIAddVersionKey "ProductName"     "${INFO_PRODUCTNAME}"

ManifestDPIAware true

!include "MUI.nsh"

!define MUI_ICON "..\icon.ico"
!define MUI_UNICON "..\icon.ico"
!define MUI_ABORTWARNING

# The last page starts the app, which then offers to connect the browsers.
!define MUI_FINISHPAGE_RUN "$INSTDIR\${PRODUCT_EXECUTABLE}"
!define MUI_FINISHPAGE_RUN_TEXT "Start Yellow Flash and connect my browsers"

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_LICENSE "..\..\..\LICENSE"
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "English"

## Signing, once a certificate exists: the path to each binary is in %1.
#!uninstfinalize 'signtool sign /fd sha256 /tr http://timestamp.digicert.com /td sha256 "%1"'
#!finalize 'signtool sign /fd sha256 /tr http://timestamp.digicert.com /td sha256 "%1"'

Name "${INFO_PRODUCTNAME}"
OutFile "..\..\bin\${INFO_PROJECTNAME}-${ARCH}-installer.exe"
InstallDir "$LOCALAPPDATA\Programs\${SHORTCUT_NAME}"
ShowInstDetails show
ShowUninstDetails show

# Asks a running Yellow Flash to save and quit (it does nothing when none
# runs), then gives it a moment to let go of its files.
!macro closeRunningApp
    ${If} ${FileExists} "$INSTDIR\${PRODUCT_EXECUTABLE}"
        DetailPrint "Closing Yellow Flash if it is running"
        ExecWait '"$INSTDIR\${PRODUCT_EXECUTABLE}" /exit'
        Sleep 1500
    ${EndIf}
!macroend

# A program still running (the browser helper while a browser is open) can't
# be overwritten but can be renamed: move it aside, delete it at the next
# restart if it is still in use.
!macro moveAside FILE
    Delete "$INSTDIR\${FILE}.old"
    ${If} ${FileExists} "$INSTDIR\${FILE}"
        Rename "$INSTDIR\${FILE}" "$INSTDIR\${FILE}.old"
        Delete /REBOOTOK "$INSTDIR\${FILE}.old"
    ${EndIf}
!macroend

Function .onInit
   !insertmacro wails.checkArchitecture
FunctionEnd

Section
    !insertmacro wails.setShellContext
    !insertmacro wails.webview2runtime

    SetOutPath $INSTDIR
    !insertmacro closeRunningApp
    !insertmacro moveAside "${PRODUCT_EXECUTABLE}"
    !insertmacro moveAside "${BROWSER_HELPER}"
    !insertmacro moveAside "yellowflash-cli.exe"
    !insertmacro moveAside "yellowflash-mcp.exe"

    !insertmacro wails.files
    File "..\..\bin\${BROWSER_HELPER}"
    File "..\..\bin\yellowflash-cli.exe"
    File "..\..\bin\yellowflash-mcp.exe"
    File "..\..\..\LICENSE"
    File "..\..\..\NOTICE.md"

    # The extension, replaced whole so no file of an older one stays.
    RMDir /r "$INSTDIR\browser-extension"
    SetOutPath "$INSTDIR\browser-extension"
    File /r "..\..\..\extension\*.*"
    SetOutPath $INSTDIR

    # Every browser (Chrome, Edge, Brave, Firefox and the others) can now
    # start the helper; the extension finds Yellow Flash once it is added.
    DetailPrint "Connecting Yellow Flash to your browsers"
    nsExec::ExecToLog '"$INSTDIR\${BROWSER_HELPER}" --register'
    Pop $0
    ${If} $0 != 0
        DetailPrint "The browsers could not be connected now; Yellow Flash retries when it starts."
    ${EndIf}

    CreateShortcut "$SMPROGRAMS\${SHORTCUT_NAME}.lnk" "$INSTDIR\${PRODUCT_EXECUTABLE}"
    CreateShortCut "$DESKTOP\${SHORTCUT_NAME}.lnk" "$INSTDIR\${PRODUCT_EXECUTABLE}"

    !insertmacro wails.associateFiles
    !insertmacro wails.associateCustomProtocols

    !insertmacro wails.writeUninstaller
SectionEnd

Section "uninstall"
    !insertmacro wails.setShellContext

    !insertmacro closeRunningApp

    # Browsers stop starting the helper; the extension then says Yellow
    # Flash isn't installed.
    ${If} ${FileExists} "$INSTDIR\${BROWSER_HELPER}"
        nsExec::ExecToLog '"$INSTDIR\${BROWSER_HELPER}" --unregister'
        Pop $0
    ${EndIf}
    # Launch at sign-in (Options → General).
    DeleteRegValue HKCU "${RUN_KEY}" "${SHORTCUT_NAME}"

    RMDir /r "$AppData\${PRODUCT_EXECUTABLE}" # WebView2's data
    RMDir /r /REBOOTOK $INSTDIR

    Delete "$SMPROGRAMS\${SHORTCUT_NAME}.lnk"
    Delete "$DESKTOP\${SHORTCUT_NAME}.lnk"

    !insertmacro wails.unassociateFiles
    !insertmacro wails.unassociateCustomProtocols

    !insertmacro wails.deleteUninstaller

    # The download list and settings (%APPDATA%\Yellow Flash) are kept, so a
    # reinstall finds them; passwords stay in Windows Credential Manager.
SectionEnd
